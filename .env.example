# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (Sommelier Digital: /api/generate-description y /api/ai/enrich)
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.8-flash)
GEMINI_MODEL=

# Pagos: Mercado Pago (checkout alojado; el pago se confirma sólo por webhook con firma)
# MP_ACCESS_TOKEN: Access Token de la aplicación (solo servidor). MP_WEBHOOK_SECRET: clave secreta de Webhooks.
# Notificaciones: configurar en Mercado Pago <NEXT_PUBLIC_SITE_URL>/api/webhooks/mercadopago (evento Pagos).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Correos transaccionales (Resend). Sin estas variables el correo de premio no se envía y queda en logs.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. Cervezaverso <hola@tu-dominio.com>
EMAIL_FROM=

# Cloudflare Turnstile (anti-bots en login, registro, recuperación y checkout).
# Sin claves se omite fuera de producción; en producción, sin clave secreta, se rechazan los envíos.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sitio (SEO: metadataBase, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://cervezaverso.com

# Google Analytics 4 (opcional; sólo carga si el visitante acepta cookies)
NEXT_PUBLIC_GA_ID=
