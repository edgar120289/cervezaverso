# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Sommelier Digital: /api/generate-description y /api/ai/enrich)
OPENAI_API_KEY=
# Opcional: modelo para /api/generate-description (por defecto gpt-4o-mini; p. ej. gpt-4o)
OPENAI_MODEL=

# Pagos: Mercado Pago (checkout alojado; el pago se confirma sólo por webhook con firma)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Cloudflare Turnstile (anti-bots en login, registro, recuperación y checkout).
# Sin claves se omite fuera de producción; en producción, sin clave secreta, se rechazan los envíos.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sitio (SEO: metadataBase, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://cervezaverso.com

# Google Analytics 4 (opcional; sólo carga si el visitante acepta cookies)
NEXT_PUBLIC_GA_ID=
